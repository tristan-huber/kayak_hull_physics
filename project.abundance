              "uniqueID": "id-75081",
              "name": "ExplodeDisjoint",
              "ioValues": [
                {
                  "name": "ShapeToExplode",
                  "ioValue": "__GEOMETRY_INPUT__"
                }
              ],
              "topLevel": false,
              "allAtoms": [
                {
                  "atomType": "Output",
                  "x": 0.98,
                  "y": 0.5,
                  "uniqueID": "id-75077",
                  "ioValues": [
