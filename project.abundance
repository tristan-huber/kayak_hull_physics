      "uniqueID": "id-74423",
      "name": "phys.CenterMass",
      "ioValues": [
        {
          "name": "defaultDensity",
          "ioValue": 1
        }
      ],
      "topLevel": false,
      "allAtoms": [
        {
          "atomType": "Output",
